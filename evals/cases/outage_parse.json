               "mock_turns": [{"type": "tool_use", "name": "OutageParse", "input": {"station_abbr": "SANL", "level_from": "platform", "level_to": null, "platform_label": "SFO/Millbrae/Daly City"}}]},
     "label": {"station_abbr": "SANL", "level_from": "platform", "level_to": null, "platform_label": "SFO/Millbrae/Daly City", "kb_elevator": "PLATFORM 2 ELEVATOR (RICHMOND, SFO/MILLBRAE/DALY CITY DIRECTIONS)"}},
    {"name": "plza_platform_richmond",
     "input": {"fragment": "PLZA: Platform - Richmond", "source": "authored",
               "mock_turns": [{"type": "tool_use", "name": "OutageParse", "input": {"station_abbr": "PLZA", "level_from": "platform", "level_to": null, "platform_label": "Richmond"}}]},
     "label": {"station_abbr": "PLZA", "level_from": "platform", "level_to": null, "platform_label": "Richmond", "kb_elevator": "PLATFORM 1 ELEVATOR (RICHMOND DIRECTION)"}},
    {"name": "embr_street_concourse",
     "input": {"fragment": "EMBR: Street - Concourse", "source": "authored",
               "mock_turns": [{"type": "tool_use", "name": "OutageParse", "input": {"station_abbr": "EMBR", "level_from": "street", "level_to": "concourse", "platform_label": null}}]},
     "label": {"station_abbr": "EMBR", "level_from": "street", "level_to": "concourse", "platform_label": null, "kb_elevator": "STREET ELEVATOR"}},
    {"name": "12th_street_ogawa_plaza",
     "input": {"fragment": "12TH: Street - 14th St/Ogawa Plaza", "source": "authored",
               "mock_turns": [{"type": "tool_use", "name": "OutageParse", "input": {"station_abbr": "12TH", "level_from": "street", "level_to": null, "platform_label": "14th St/Ogawa Plaza"}}]},
     "label": {"station_abbr": "12TH", "level_from": "street", "level_to": null, "platform_label": "14th St/Ogawa Plaza", "kb_elevator": "STREET ELEVATOR (14TH STREET/OGAWA PLAZA)"}},
    {"name": "ashb_street_concourse",
     "input": {"fragment": "ASHB: Street - Concourse", "source": "authored",
               "mock_turns": [{"type": "tool_use", "name": "OutageParse", "input": {"station_abbr": "ASHB", "level_from": "street", "level_to": "concourse", "platform_label": null}}]},
     "label": {"station_abbr": "ASHB", "level_from": "street", "level_to": "concourse", "platform_label": null, "kb_elevator": "STREET ELEVATOR"}},
    {"name": "mcar_platform_antioch_richmond",
     "input": {"fragment": "MCAR: Platform - Antioch/Richmond", "source": "authored",
               "mock_turns": [{"type": "tool_use", "name": "OutageParse", "input": {"station_abbr": "MCAR", "level_from": "platform", "level_to": null, "platform_label": "Antioch/Richmond"}}]},
     "label": {"station_abbr": "MCAR", "level_from": "platform", "level_to": null, "platform_label": "Antioch/Richmond", "kb_elevator": "PLATFORMS 1 AND 3 ELEVATOR (ANTIOCH, RICHMOND DIRECTIONS)"}},
    {"name": "wdub_garage_north_is_ambiguous",
     "input": {"fragment": "WDUB: Garage - North/Dublin", "source": "authored; two garage elevators share the north side, so code must refuse to pick one",
               "mock_turns": [{"type": "tool_use", "name": "OutageParse", "input": {"station_abbr": "WDUB", "level_from": "garage", "level_to": null, "platform_label": "North/Dublin"}}]},
