// Generated by scripts/gen_cedar.py from the KB export (see manifest.json for the source tag).
// Do not edit by hand. Regenerate with `make agentcore-policy-gen`.
// Default deny, forbid wins: tools accept only KB stations, KB elevators, and BART's option labels.

// draft_plan.option: forbid any option label outside the set (forbid wins)
forbid(
  principal,
  action == AgentCore::Action::"last-elevator-mcp___draft_plan",
  resource == AgentCore::Gateway::"${GATEWAY_ARN}"
)
when {
  context.input has option && !(["alternate_elevator", "backtracking", "transit", "mitigation_trip", "mitigation_shuttle"].contains(context.input.option))
};
