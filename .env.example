# Variable NAMES only. Copy to .env locally; .env is gitignored and must never be committed.

# --- Amazon Bedrock (optional). Without these, everything runs on the offline mock provider at $0.
# AWS_REGION=us-west-2
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_BEARER_TOKEN_BEDROCK=

# --- BART API (optional). Without it, the BART client reads fixtures/bart/*.json.
# Register for a key at https://api.bart.gov
# BART_API_KEY=
