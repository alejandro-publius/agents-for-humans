# Copy to .env and fill in. Never commit .env.

# --- Model provider ---------------------------------------------------------
# bedrock (default) | anthropic | openai | ollama
AFH_MODEL_PROVIDER=bedrock
# Leave empty for the provider default (Bedrock: global.anthropic.claude-sonnet-4-6)
AFH_MODEL_ID=

# --- Amazon Bedrock (default provider) ---------------------------------------
# Either run `aws configure`, or set these, or use a Bedrock API key.
AWS_REGION=us-west-2
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_BEARER_TOKEN_BEDROCK=

# --- Other providers (install the matching extra: uv sync --extra anthropic) --
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OLLAMA_HOST=http://localhost:11434

# --- Agent state ------------------------------------------------------------
AFH_SESSION_DIR=.sessions
